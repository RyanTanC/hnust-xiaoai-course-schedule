# ════════════════════════════════════════════════════════════════════
#  小爱课程表 · HNUST 教务助手 — 环境变量模板
# ════════════════════════════════════════════════════════════════════
#
# 使用方法：
#   复制本文件为 .env，填入真实值。
#   .env 已被 .gitignore 屏蔽，不会进仓库。
#
# 说明：
#   以下凭证是「小米开放平台」为小爱课程表 App 注册的公共服务凭证，
#   不是个人账号凭证。但仍不应硬编码进源码，请通过环境变量注入。

# ── 小米开放平台应用凭证 ──
# 用于密码登录 / 扫码登录流程中签发 Access Token
XIAOMI_CLIENT_ID=
XIAOMI_CLIENT_SECRET=

# ── Flask 会话密钥（可选）──
# 不设置时程序会自动生成并持久化到 data/.secret_key
FLASK_SECRET_KEY=

# ── 服务端口（可选，默认 8080）──
PORT=8080
